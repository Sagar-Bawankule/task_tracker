# Postgres connection string (on Vercel: add a Neon database from the Storage tab - it sets this for you)
# Leave empty locally to use the built-in local database stored in ./.pglite
DATABASE_URL=

# Long random string used to sign login sessions (REQUIRED in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Timezone used for "today", weeks and months
APP_TIMEZONE=Asia/Kolkata
